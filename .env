# LifeOS settings for this folder. Dockge shows this file in its .env panel; install.sh fills it in
# on a laptop; or edit it by hand. After a change: Deploy in Dockge, or `docker compose up -d`.
# Lines starting with # are comments.
#
# On a NAS (Dockge, ZimaOS, TrueNAS, Unraid) set three things, then Deploy:
#   LIFEOS_VAULT_HOST   your notes folder on the NAS
#   LIFEOS_BIND=0.0.0.0 so your phone and computers can open it
#   LIFEOS_UID/GID      the owner of the notes folder
# Everything else has a working default. See README.md, "Install on a NAS".

# ---------------------------------------------------------------- your notes
# The folder of your notes (plain .md files: an Obsidian vault, or any folder). Required.
# An empty folder gets a few starter notes on the first start (a folder with anything in it never does).
# NAS: ZimaOS /DATA/Documents/Notes   TrueNAS /mnt/<pool>/notes   Unraid /mnt/user/notes
# Computer: /home/sara/Notes   /Users/sara/Documents/Notes   C:/Users/Sara/Documents/Notes
LIFEOS_VAULT_HOST=

# The user and group LifeOS writes your notes as: the notes folder's owner, so the files stay theirs.
# ZimaOS: usually 1000 and 1000. TrueNAS: the apps user, 568 and 568 (or the dataset's owner).
# Unraid: 99 and 100. Linux: `id -u` and `id -g` (install.sh fills them in). macOS and Windows:
# leave them. If they are wrong, the api container's log says so at start, with the owner it found.
LIFEOS_UID=1000
LIFEOS_GID=1000

# ---------------------------------------------------------------- where it listens
# The port LifeOS answers on. Change it if 8480 is taken.
LIFEOS_PORT=8480
# 127.0.0.1: only this machine can open it (reach it from your phone through Tailscale or another
# HTTPS proxy, see the README). 0.0.0.0: every device on your network can, at http://<nas-ip>:8480/lifeos
# (passphrase protected, but plain http: no app on the home screen and no notifications until you
# put https in front, see "HTTPS on a NAS" in the README).
LIFEOS_BIND=127.0.0.1
# The address you open LifeOS at, when it is not http://localhost:<port>/lifeos (for example
# http://192.168.1.20:8480/lifeos, or https://nas.tailnet-name.ts.net/lifeos). Reminder links and
# the Hermes prompt use it.
LIFEOS_PUBLIC_URL=

# The time zone until you pick your city on the first run (then the city's zone is used). The
# starter notes are dated today in this zone: set yours (for example America/Toronto) to match.
TZ=UTC

# ---------------------------------------------------------------- switches
# on: Telegram reminders when .env.telegram is there; off: never.
LIFEOS_TELEGRAM=on
# on: Hermes or the AI provider you choose (Settings > Hermes, Settings > Advanced > AI, or .env.ai)
# may draft for you; off: never, plain drafts only.
LIFEOS_AI=on
# off: never put the starter notes in an empty notes folder.
LIFEOS_STARTER=on
# Leave as is.
LIFEOS_MODE=live

# ---------------------------------------------------------------- advanced (rarely needed)
# The name of this installation's containers, network and volumes (two copies on one machine need
# two names). In Dockge, name the stack (its folder) the same, so Dockge shows it as running.
# A Hermes in Docker on this machine reaches LifeOS at http://<name>-api:8481 on <name>-net.
LIFEOS_NAME=lifeos
# LIFEOS_DATA_VOLUME=lifeos-data
# Where the passphrase file (.env.auth) is kept. Empty: in LifeOS's data volume. A folder (for
# example . for this one): there, so you can delete it to set a new passphrase.
LIFEOS_AUTH_DIR=
# The first-run answers as JSON, to skip that screen (for example on a server you set up for
# someone else): {"place":"Toronto, Ontario, Canada","lat":43.6532,"lon":-79.3832,
# "tz":"America/Toronto","method":"tehran","hijriOffset":0,"prayerCheck":false,"vaultName":""}
LIFEOS_SETUP_SEED=

# ---------------------------------------------------------------- secrets: their own files
# None is needed: LifeOS makes the search service's secret and the browser notifications' keys
# itself on the first start (in its volumes). Optional files beside this one, readable only by you:
#
# .env.ai        a model for the AI drafts (or choose one in Settings > Advanced > AI)
#                  AI_PROVIDER=local            local | openai | anthropic | other | off
#                  AI_BASE_URL=http://host.docker.internal:11434/v1
#                  AI_MODEL=llama3.1:8b
#                  AI_API_KEY=                  (if your server needs one)
# .env.telegram  Telegram reminders from LifeOS's own bot (with Hermes you need none)
#                  TELEGRAM_BOT_TOKEN=123456:ABC...   from @BotFather
#                  TELEGRAM_CHAT_ID=123456789          your chat with the bot
#                  TELEGRAM_THREAD_ID=                 a topic in a group, if you use one
# .env.push      your own browser-notification keys (an older install.sh made one; kept if present)
#                  LIFEOS_VAPID_PUBLIC_KEY=...   LIFEOS_VAPID_PRIVATE_KEY=...
# .env.searxng   your own search-service secret (an older install.sh made one; kept if present)
#                  SEARXNG_SECRET=...
